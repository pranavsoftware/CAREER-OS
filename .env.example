# ============================================================
# CAREER-OS Environment Variables
# ============================================================
# Copy this file to .env.local for local overrides.
# For Vercel: add these in Project Settings → Environment Variables.
# For Render (AI service only): add PORT=8000 in its dashboard.
# ============================================================

# --- Supabase PostgreSQL (Database) ---
# Port 6543 is TRANSACTION MODE (mandatory for Vercel Serverless to prevent pool exhaustion)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres"
PGHOST="aws-0-ap-northeast-2.pooler.supabase.com"
PGPORT="6543"
PGDATABASE="postgres"
PGUSER="postgres.<project-ref>"
PGPASSWORD="<your-supabase-password>"
PGSSLMODE="require"

# --- Render AI Service (STT + TTS) ---
# Set this on Vercel to point to your Render service URL.
# Example: https://career-os-ai-service.onrender.com
AI_SERVICE_URL="http://127.0.0.1:8000"
